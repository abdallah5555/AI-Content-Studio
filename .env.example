# Web
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Worker/server only
# Dedicated AI Content Studio project only. Never point these variables at Talbak/Talabatk Delivery.
SUPABASE_URL=https://avmcavsqeahcepfwsoun.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=openrouter/free
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Runtime persistence and media
# SQLite remains the local/CI fallback. Production automatically prefers Supabase
# when SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are both configured.
JOB_DB_PATH=data/ai_content_studio.db
REFERENCE_DB_PATH=data/references.db
INTELLIGENCE_DB_PATH=data/content_intelligence.db
SCHEDULE_DB_PATH=data/content_schedule.db
MUSIC_LIBRARY_DIR=assets/music
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Deployment
# Comma-separated origins allowed to call the worker.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173

# Trend Radar
# The core radar uses free public sources and does not require a paid API key.
# Google Trends public trending feed is used as the primary live signal.
